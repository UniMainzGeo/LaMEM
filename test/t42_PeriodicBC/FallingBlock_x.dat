# t42_PeriodicBC: falling block with geometric multigrid and periodic boundary conditions (periodic in x).
# Reduced from examples/BuiltInSetups/FallingBlock_Multigrid.dat: a single dense, viscous block
# centered in the box sinks for 5 time steps. Since the block is centered and symmetric, the mirror
# images of the free-slip solution form the same lattice as the periodic images, hence the x-, y- and
# xy-periodic variants (and the free-slip solution) agree up to solver tolerance.

#===============================================================================
# Scaling
#===============================================================================

	units = none

#===============================================================================
# Time stepping parameters
#===============================================================================

	time_end  = 100   # simulation end time
	dt        = 10    # time step
	dt_min    = 1e-5  # minimum time step (declare divergence if lower value is attempted)
	dt_max    = 100   # maximum time step
	dt_out    = 0.2   # output step (output at least at fixed time intervals)
	inc_dt    = 0.1   # time step increment per time step (fraction of unit)
	CFL       = 0.2   # CFL (Courant-Friedrichs-Lewy) criterion (limits every step, so the time step tracks the maximum velocity)
	CFLMAX    = 0.5   # CFL criterion for elasticity
	nstep_max = 5     # maximum allowed number of steps (lower bound: time_end/dt_max)
	nstep_out = 1     # save output every n steps
	nstep_rdb = 0     # save restart database every n steps

#===============================================================================
# Grid & discretization parameters
#===============================================================================

# Number of cells for all segments

	nel_x = 16
	nel_y = 16
	nel_z = 16

# Coordinates of all segments (including start and end points)

	coord_x = 0.0 1.0
	coord_y = 0.0 1.0
	coord_z = 0.0 1.0

# Periodic geometry flags
# periodic_x = 1 : periodic in x-direction (left/right)
# periodic_y = 1 : periodic in y-direction (front/back)

	periodic_x = 1

#===============================================================================
# Free surface
#===============================================================================

# Default

#===============================================================================
# Boundary conditions
#===============================================================================

# No-slip boundary flag mask (left right front back bottom top)
# periodic boundaries require no-slip at the bottom

	noslip = 0 0 0 0 1 0

#===============================================================================
# Solution parameters & controls
#===============================================================================

	gravity        = 0.0 0.0 -1.0   # gravity vector
	FSSA           = 1.0            # free surface stabilization parameter [0 - 1]
	init_guess     = 0              # initial guess flag
	eta_min        = 1e-3           # viscosity upper bound
	eta_max        = 1e12           # viscosity lower limit

#===============================================================================
# Model setup & advection
#===============================================================================

	msetup         = geom              # setup type
	nmark_x        = 3                 # markers per cell in x-direction
	nmark_y        = 3                 # ...                 y-direction
	nmark_z        = 3                 # ...                 z-direction
	bg_phase       = 0                 # background phase ID
	rand_noise     = 0                 # random noise flag (off: results independent of the number of processors)
	advect         = rk2               # advection scheme (periodic wrapping of the intermediate positions)
	mark_ctrl      = none              # marker control type

# Geometric primitives:

	<BoxStart>
		phase  = 1
		bounds = 0.375 0.625 0.375 0.625 0.6 0.85  # (left, right, front, back, bottom, top)
	<BoxEnd>

#===============================================================================
# Output
#===============================================================================

# Grid output options (output is always active)

	out_file_name       = FallingBlock # output file name
	out_pvd             = 0            # activate writing .pvd file

#===============================================================================
# Material phase parameters
#===============================================================================

	# Define properties of matrix
	<MaterialStart>
		ID  = 0 # phase id
		rho = 1 # density
		eta = 1 # viscosity
	<MaterialEnd>

	# Define properties of block
	<MaterialStart>
		ID  = 1   # phase id
		rho = 2   # density
		eta = 100 # viscosity
	<MaterialEnd>

#===============================================================================
# Solver options
#===============================================================================

<SolverOptionsStart>

	set_linear_problem  = 1
	monitor_solvers     = 1
	linear_tolerances   = 1e-6 1e-8 200 # rtol, atol, maxit
	num_mg_levels       = 3
	stokes_solver       = coupled_mg
	smoother_type       = light        # richardson + jacobi (processor independent)
	smoother_num_sweeps = 5
	coarse_solver       = direct       # processor independent
	coarse_num_cpu      = 1

<SolverOptionsEnd>

#===============================================================================
