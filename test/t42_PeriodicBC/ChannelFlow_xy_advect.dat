# t42_PeriodicBC: marker advection across periodic boundaries. Doubly periodic channel flow
# (periodic in x and y) driven by a diagonal body force, with a viscous inclusion that straddles
# the corner where the periodic faces meet (x = 0/2, y = 0/1). The inclusion is advected across
# both periodic faces over several time steps, hence the residuals of the later steps depend on
# the markers being correctly wrapped and exchanged between processors. The results must be
# independent of the number of processors (up to round-off).

#===============================================================================
# Scaling
#===============================================================================

	units = none

#===============================================================================
# Time stepping parameters
#===============================================================================

	time_end  = 100.0 # simulation end time
	dt        = 1.0   # time step
	dt_min    = 1e-9  # minimum time step (declare divergence if lower value is attempted)
	dt_max    = 1.0   # maximum time step
	dt_out    = 0.2   # output step (output at least at fixed time intervals)
	inc_dt    = 0.1   # time step increment per time step (fraction of unit)
	CFL       = 0.5   # CFL (Courant-Friedrichs-Lewy) criterion
	CFLMAX    = 0.5   # CFL criterion for elasticity
	nstep_max = 8     # maximum allowed number of steps (lower bound: time_end/dt_max)
	nstep_out = 1     # save output every n steps
	nstep_rdb = 0     # save restart database every n steps


#===============================================================================
# Grid & discretization parameters
#===============================================================================

# Number of cells for all segments

	nel_x = 32
	nel_y = 16
	nel_z = 16

# Coordinates of all segments (including start and end points)

	coord_x = 0.0 2.0
	coord_y = 0.0 1.0
	coord_z = 0.0 1.0

# Periodic geometry flags
# periodic_x = 1 : periodic in x-direction (left/right)
# periodic_y = 1 : periodic in y-direction (front/back), see *_PeriodicY_* examples
	
	periodic_x = 1
	periodic_y = 1

#===============================================================================
# Free surface
#===============================================================================

# Default

#===============================================================================
# Boundary conditions
#===============================================================================

# No-slip boundary flag mask (left right front back bottom top)

    noslip = 0 0 0 0 1 0

#===============================================================================
# Solution parameters & controls
#===============================================================================

	gravity        = 0.07 0.07 0.0  # gravity vector (diagonal, drives flow across both periodic faces)
	FSSA           = 1.0            # free surface stabilization parameter [0 - 1]

#	act_temp_diff  = 1              # temperature diffusion activation flag

#	act_steady_temp = 1              # steady-state temperature initial guess activation flag

	init_guess     = 0              # initial guess flag
	eta_min        = 1e-3           # viscosity upper bound
	eta_max        = 1e12           # viscosity lower limit

#===============================================================================
# Solver options
#===============================================================================

#===============================================================================
# Model setup & advection
#===============================================================================

	msetup         = geom              # setup type
	mark_ctrl      = none              # marker control (keep markers as they are)
	advect         = basic             # advection scheme
	nmark_x        = 2                 # markers per cell in x-direction
	nmark_y        = 2                 # ...                 y-direction
	nmark_z        = 2                 # ...                 z-direction
	bg_phase       = 0                 # background phase ID

# Geometric primtives:

# viscous inclusion straddling the x = 0/2 and y = 0/1 periodic faces (four pieces)

	<BoxStart>
		phase  = 1
		bounds = 1.75 2.0 0.875 1.0 0.25 0.75  # (left, right, front, back, bottom, top)
	<BoxEnd>

	<BoxStart>
		phase  = 1
		bounds = 0.0 0.25 0.875 1.0 0.25 0.75
	<BoxEnd>

	<BoxStart>
		phase  = 1
		bounds = 1.75 2.0 0.0 0.125 0.25 0.75
	<BoxEnd>

	<BoxStart>
		phase  = 1
		bounds = 0.0 0.25 0.0 0.125 0.25 0.75
	<BoxEnd>


#===============================================================================
# Output
#===============================================================================

# Grid output options (output is always active)

	out_file_name       = ChannelFlow # output file name
	out_pvd             = 0           # activate writing .pvd file
	out_j2_dev_stress   = 1
	out_dev_stress      = 1
	out_strain_rate     = 1
	out_j2_strain_rate  = 1
	out_density = 1
	
# AVD phase viewer output options (requires activation)

#	out_avd     = 1 # activate AVD phase output
#	out_avd_pvd = 1 # activate writing .pvd file
#	out_avd_ref = 3 # AVD grid refinement factor

#===============================================================================
# Material phase parameters
#===============================================================================

	# Define properties of matrix
	<MaterialStart>
		ID  = 0 # phase id
		rho = 1 # density
		eta = 1 # viscosity
		Cp  = 1
		k   = 1
		
	<MaterialEnd>

	# Define properties of block
	<MaterialStart>
		ID  = 1   # phase id
		rho = 1   # density
		eta = 10  # viscosity (viscous inclusion, makes the flow 3D)
		Cp  = 1
		k   = 1
	<MaterialEnd>

#===============================================================================
# Solver options
#===============================================================================


<SolverOptionsStart>

	set_linear_problem   =  1
	monitor_solvers      =  1
	linear_tolerances    =  1e-6 1e-6 100   # rtol, atol, maxit
	stokes_solver        =  coupled_mg          
	smoother_type        =  light           # richardson + jacobi
	smoother_num_sweeps  =  5
	coarse_solver        =  direct               
     num_mg_levels        =  3
     coarse_num_cpu       =  1

<SolverOptionsEnd>

#===============================================================================

